# Copiar a .env (ignorado por git) y completar. launch.json de VS Code lo carga como envFile.

# --- AWS Cognito (mismo User Pool que catalog, audit y el resto de los microservicios) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Microservicios de dominio ---
CATALOG_SERVICE_URL=http://localhost:8081
AUDIT_SERVICE_URL=http://localhost:8083

# --- Frontend Angular ---
FRONTEND_URL=http://localhost:4200

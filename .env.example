# Copiar a .env (ignorado por git) y completar. launch.json de VS Code y docker-compose lo cargan.

# --- AWS Cognito (mismo User Pool que catalog, audit y el resto de los microservicios) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Microservicios de dominio (Ejecución local en host) ---
# Si ejecutas el BFF directamente con Maven/IDE:
CATALOG_SERVICE_URL=http://localhost:8081
RESERVATIONS_SERVICE_URL=http://localhost:8082
AUDIT_SERVICE_URL=http://localhost:8083
USERS_SERVICE_URL=http://localhost:8085

# --- Microservicios de dominio (Ejecución dentro de Docker Compose) ---
# Descomentar si ejecutas con docker compose y los otros servicios están en el host:
# CATALOG_SERVICE_URL=http://host.docker.internal:8081
# RESERVATIONS_SERVICE_URL=http://host.docker.internal:8082
# AUDIT_SERVICE_URL=http://host.docker.internal:8083
# USERS_SERVICE_URL=http://host.docker.internal:8085

# --- Frontend Angular ---
FRONTEND_URL=http://localhost:4200
